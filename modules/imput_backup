import streamlit as st
import pandas as pd
import os
from datetime import datetime

def render_modul_1():
    st.subheader("Modul 1: Penginputan Dokumen & Manajemen Persetujuan (Workflow)")

    # Pilihan Departemen Tujuan (Hierarki)
    st.markdown("#### 🎯 Alokasi Departemen Tujuan Dokumen")
    dept_pilihan_input = st.selectbox(
        "Pilih Departemen Tujuan Dokumen (Wajib Sesuai Hierarki)",
        ["-- Pilih Departemen Tujuan --", "Operasional", "HRD", "Logistik", "Maintenance", "HSE", "Akuntansi"],
        key="selectbox_dept_tujuan_input"
    )
    st.markdown("---")

    # Inisialisasi State Data Operasional Pusat
    if 'data_operasional' not in st.session_state:
        st.session_state.data_operasional = pd.DataFrame(columns=[
            "Nomor Bukti", "Tanggal", "Sumber Transaksi", "Lawan Transaksi", 
            "No Invoice", "Jatuh Tempo", "Business Unit", "Departemen Tujuan", "Jumlah", "Satuan", "Peruntukan", "Keterangan", 
            "DPP", "PPN", "PPH", "Total", "Status Dokumen", "Status Jurnal"
        ])

    if 'form_index' not in st.session_state:
        st.session_state.form_index = 0

    list_sumber_opsi = [
        "Kas Bank Masuk (Penerimaan Dana)", 
        "Penerbitan Invoice / Tagihan Penjualan (Piutang Usaha)",
        "Tagihan / Pembelian Kredit (Hutang Usaha)",
        "Kas Besar / Kas Proyek", 
        "Kas Kecil (Petty Cash)", 
        "Bank Keluar / Pembayaran",
        "Logistik & Pengadaan Barang", 
        "Gudang", 
        "Memorial / Koreksi"
    ]

    if 'selected_sumber_trx' not in st.session_state:
        st.session_state.selected_sumber_trx = list_sumber_opsi[0]

    menu_tab = st.radio(
        "Pilih Menu Navigasi Modul:",
        ["📝 Form Penginputan Dokumen", "📂 Data Tersimpan & Approval (Pusat Kendali)"],
        horizontal=True,
        key="nav_modul_1"
    )

    if menu_tab == "📝 Form Penginputan Dokumen":
        st.markdown("### ✍️ Form Entri Dokumen Harian")
        
        sumber_transaksi = st.selectbox("Pilih Sumber Dokumen", list_sumber_opsi, key="selectbox_sumber_trx")
        
        if st.session_state.selected_sumber_trx != sumber_transaksi:
            st.session_state.selected_sumber_trx = sumber_transaksi
            st.session_state.form_index += 1
            st.rerun()

        col_reset1, col_reset2 = st.columns([3, 1])
        with col_reset2:
            if st.button("🧹 Reset Form Baru", use_container_width=True):
                st.session_state.form_index += 1
                st.success("Form berhasil dibersihkan!")
                st.rerun()

        idx = st.session_state.form_index

        # =========================================================================
        # PEMBACAAN LANGSUNG DARI FILE FISIK EXCEL MASTER (DIJAMIN DINAMIS)
        # =========================================================================

        # 1. Business Unit: Membaca langsung dari file master_bu_bss.xlsx
        list_bu_opt = []
        file_bu_path = "master_bu_bss.xlsx"
        if os.path.exists(file_bu_path):
            try:
                df_bu = pd.read_excel(file_bu_path)
                df_bu.columns = df_bu.columns.str.replace('\xa0', ' ').str.strip()
                if len(df_bu.columns) >= 2:
                    col_k = df_bu.columns[0]
                    col_n = df_bu.columns[1]
                    list_bu_opt = (df_bu[col_k].astype(str).str.strip() + " - " + df_bu[col_n].astype(str).str.strip()).tolist()
            except Exception:
                pass

        # 2. Pelanggan / Customer: Membaca langsung dari file master_pelanggan_bss.xlsx (Kolom Index 1)
        list_pelanggan_opt = []
        file_pel_path = "master_pelanggan_bss.xlsx"
        if os.path.exists(file_pel_path):
            try:
                df_pel = pd.read_excel(file_pel_path)
                df_pel.columns = df_pel.columns.str.replace('\xa0', ' ').str.strip()
                col_target = df_pel.columns[1] if len(df_pel.columns) > 1 else df_pel.columns[0]
                list_pelanggan_opt = df_pel[col_target].dropna().astype(str).str.strip().tolist()
            except Exception:
                pass

        # 3. Alokasi Alat / Unit: Membaca langsung dari file master_alat_bss.xlsx
        list_alat_opt = []
        file_alat_path = "master_alat_bss.xlsx"
        if os.path.exists(file_alat_path):
            try:
                df_alat = pd.read_excel(file_alat_path)
                df_alat.columns = df_alat.columns.str.replace('\xa0', ' ').str.strip()
                if len(df_alat.columns) >= 2:
                    col_a1 = df_alat.columns[1]
                    col_a2 = df_alat.columns[3] if len(df_alat.columns) > 3 else None
                    if col_a2 and col_a2 in df_alat.columns:
                        list_alat_opt = (df_alat[col_a1].astype(str).str.strip() + " (" + df_alat[col_a2].astype(str).str.strip() + ")").tolist()
                    else:
                        list_alat_opt = df_alat[col_a1].dropna().astype(str).str.strip().tolist()
            except Exception:
                pass

        # 4. Supplier / Pemasok
        list_supplier_opt = []
        file_supp_path = "master_pemasok_bss.xlsx"
        if os.path.exists(file_supp_path):
            try:
                df_supp = pd.read_excel(file_supp_path)
                df_supp.columns = df_supp.columns.str.replace('\xa0', ' ').str.strip()
                col_sup = df_supp.columns[1] if len(df_supp.columns) > 1 else df_supp.columns[0]
                list_supplier_opt = df_supp[col_sup].dropna().astype(str).str.strip().tolist()
            except Exception:
                pass

        # 5. Kas & Bank (COA)
        list_kas_bank_opt = []
        file_coa_path = "master_coa_bss.xlsx"
        if os.path.exists(file_coa_path):
            try:
                df_coa = pd.read_excel(file_coa_path)
                df_coa.columns = df_coa.columns.str.replace('\xa0', ' ').str.strip()
                col_kode = df_coa.columns[0]
                col_nama = df_coa.columns[1] if len(df_coa.columns) > 1 else df_coa.columns[0]
                mask_kb = df_coa[col_kode].astype(str).str.startswith(('111', '112'))
                df_kb = df_coa[mask_kb]
                if not df_kb.empty:
                    list_kas_bank_opt = (df_kb[col_kode].astype(str).str.strip() + " - " + df_kb[col_nama].astype(str).str.strip()).tolist()
            except Exception:
                pass

        if 'master_satuan' not in st.session_state:
            st.session_state.master_satuan = ["Pcs", "Ls", "Kg", "Liter", "Trip", "Jam", "Hari", "Lot", "Bulan", "Unit"]

        if f'val_ppn_{idx}' not in st.session_state: st.session_state[f'val_ppn_{idx}'] = 0.0
        if f'val_pph_{idx}' not in st.session_state: st.session_state[f'val_pph_{idx}'] = 0.0

        with st.container():
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>📅 **Tanggal Transaksi**", unsafe_allow_html=True)
            with c2: tgl = st.date_input("Tanggal", datetime.now(), label_visibility="collapsed", key=f"tgl_{idx}")
            
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>🧾 **Nomor Bukti / Ref Internal**", unsafe_allow_html=True)
            with c2: no_bukti = st.text_input("No Bukti", placeholder="Cth: BSS/TRX/VIII/2026/001", label_visibility="collapsed", key=f"nobukti_{idx}")
            
            no_invoice_final = "-"
            tgl_jatuh_tempo = "-"
            lawan_transaksi_final = ""
            bank_penerima = "-"
            suggested_dpp = 0.0
            
            if sumber_transaksi == "Kas Bank Masuk (Penerimaan Dana)":
                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>🏦 **Akun Kas / Rekening Bank Penerima**", unsafe_allow_html=True)
                with c2: bank_penerima = st.selectbox("Pilih Kas/Bank", ["-- Pilih Akun Kas / Bank --"] + list_kas_bank_opt, key=f"bank_terima_{idx}", label_visibility="collapsed")
                
                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>👥 **Pihak Ketiga / Pelanggan**", unsafe_allow_html=True)
                with c2:
                    sub_cust1, sub_cust2 = st.columns([3, 1])
                    with sub_cust1:
                        pelanggan_pilihan = st.selectbox("Pilih Pelanggan", ["-- Pilih Pelanggan --"] + list_pelanggan_opt, key=f"pihak_ketiga_{idx}", label_visibility="collapsed")
                    with sub_cust2:
                        tambah_pelanggan_baru = st.text_input("Pelanggan Baru", placeholder="Ketik baru...", key=f"tambah_pelanggan_{idx}", label_visibility="collapsed")
                    
                    lawan_transaksi_final = pelanggan_pilihan if pelanggan_pilihan != "-- Pilih Pelanggan --" else ""
                    if tambah_pelanggan_baru.strip():
                        lawan_transaksi_final = tambah_pelanggan_baru.strip()
                
                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>📑 **Jenis Penerimaan**", unsafe_allow_html=True)
                with c2: jenis_terima = st.radio("Jenis Penerimaan", ["Pelunasan Tagihan (Berdasarkan Invoice)", "Penerimaan Tunai / Non-Invoice (Input Manual)"], key=f"jenis_terima_{idx}", label_visibility="collapsed")
                
                if jenis_terima == "Pelunasan Tagihan (Berdasarkan Invoice)":
                    c1, c2 = st.columns([1, 2])
                    with c1: st.markdown("<br>🏷️ **Nomor Invoice Tagihan**", unsafe_allow_html=True)
                    with c2: 
                        if not st.session_state.data_operasional.empty:
                            df_op = st.session_state.data_operasional
                            mask_cust = (df_op['Lawan Transaksi'] == lawan_transaksi_final) & (df_op['No Invoice'] != '-')
                            inv_tercatat = df_op[mask_cust]['No Invoice'].unique().tolist()
                        else:
                            inv_tercatat = []
                        list_inv_opsi = inv_tercatat if inv_tercatat else ["Belum ada invoice tercatat"]
                        list_inv_opsi.append("INV-Lainnya (Manual)")
                        
                        pilih_inv = st.selectbox("Pilih Invoice", ["-- Pilih Invoice --"] + list_inv_opsi, key=f"pilih_inv_{idx}", label_visibility="collapsed")
                        if pilih_inv == "INV-Lainnya (Manual)" or "Belum ada invoice" in pilih_inv:
                            no_invoice_final = st.text_input("Ketik Nomor Invoice Manual", placeholder="Cth: INV/BSS/2026/001", key=f"inv_manual_{idx}")
                        else:
                            no_invoice_final = pilih_inv if pilih_inv != "-- Pilih Invoice --" else ""
                            if not st.session_state.data_operasional.empty:
                                matched_row = st.session_state.data_operasional[st.session_state.data_operasional['No Invoice'] == no_invoice_final]
                                if not matched_row.empty:
                                    suggested_dpp = float(matched_row.iloc[0]['DPP'])
                else:
                    no_invoice_final = "NON-INVOICE (Tunai / Penerimaan Langsung)"

            elif sumber_transaksi == "Penerbitan Invoice / Tagihan Penjualan (Piutang Usaha)":
                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>👥 **Pelanggan / Customer (Debitur)**", unsafe_allow_html=True)
                with c2:
                    sub_cust1, sub_cust2 = st.columns([3, 1])
                    with sub_cust1:
                        pelanggan_pilihan = st.selectbox("Pilih Pelanggan", ["-- Pilih Pelanggan --"] + list_pelanggan_opt, key=f"pelanggan_sel_{idx}", label_visibility="collapsed")
                    with sub_cust2:
                        tambah_pelanggan_baru = st.text_input("Pelanggan Baru", placeholder="Ketik baru...", key=f"tambah_pelanggan_{idx}", label_visibility="collapsed")
                    lawan_transaksi_final = pelanggan_pilihan if pelanggan_pilihan != "-- Pilih Pelanggan --" else ""
                    if tambah_pelanggan_baru.strip(): lawan_transaksi_final = tambah_pelanggan_baru.strip()

                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>🏷️ **Nomor Invoice Perusahaan**", unsafe_allow_html=True)
                with c2: no_invoice_final = st.text_input("No Invoice Tagihan", placeholder="Cth: INV/BSS/2026/001", key=f"inv_perusahaan_{idx}", label_visibility="collapsed")

                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>⏳ **Jatuh Tempo Piutang**", unsafe_allow_html=True)
                with c2: tgl_jatuh_tempo = st.date_input("Jatuh Tempo Piutang", datetime.now(), key=f"duedate_ar_{idx}", label_visibility="collapsed")

            elif sumber_transaksi == "Tagihan / Pembelian Kredit (Hutang Usaha)":
                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>🏢 **Supplier / Vendor**", unsafe_allow_html=True)
                with c2:
                    sub_sup1, sub_sup2 = st.columns([3, 1])
                    with sub_sup1:
                        supplier_pilihan = st.selectbox("Pilih Supplier", ["-- Pilih Supplier --"] + list_supplier_opt, key=f"supplier_sel_{idx}", label_visibility="collapsed")
                    with sub_sup2:
                        tambah_supplier_baru = st.text_input("Supplier Baru", placeholder="Ketik baru...", key=f"tambah_supplier_{idx}", label_visibility="collapsed")
                    lawan_transaksi_final = supplier_pilihan if supplier_pilihan != "-- Pilih Supplier --" else ""
                    if tambah_supplier_baru.strip(): lawan_transaksi_final = tambah_supplier_baru.strip()

                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>🏷️ **No Invoice Supplier**", unsafe_allow_html=True)
                with c2: no_invoice_final = st.text_input("No Invoice Supplier", placeholder="Cth: INV-SUPPLIER/2026/888", key=f"inv_supp_{idx}", label_visibility="collapsed")

                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>⏳ **Jatuh Tempo Hutang**", unsafe_allow_html=True)
                with c2: tgl_jatuh_tempo = st.date_input("Jatuh Tempo Hutang", datetime.now(), key=f"duedate_ap_{idx}", label_visibility="collapsed")

            else:
                c1, c2 = st.columns([1, 2])
                with c1: st.markdown("<br>🏢 **Pihak Terkait**", unsafe_allow_html=True)
                with c2: lawan_transaksi_final = st.text_input("Pihak Terkait", placeholder="Nama pihak terkait...", key=f"pihak_lain_{idx}", label_visibility="collapsed")

            # Business Unit / Proyek (Terbaca dinamis langsung dari file Excel tersimpan)
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>🏢 **Business Unit / Proyek**", unsafe_allow_html=True)
            with c2:
                sub_bu1, sub_bu2 = st.columns([3, 1])
                with sub_bu1:
                    bu_pilihan = st.selectbox("Business Unit", ["-- Pilih Business Unit --"] + list_bu_opt, label_visibility="collapsed", key=f"bu_{idx}")
                with sub_bu2:
                    tambah_bu_baru = st.text_input("BU Baru", placeholder="Ketik baru...", key=f"tambah_bu_{idx}", label_visibility="collapsed")
                bu_final = bu_pilihan if bu_pilihan != "-- Pilih Business Unit --" else ""
                if tambah_bu_baru.strip(): bu_final = tambah_bu_baru.strip()
            
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>📦 **Jumlah (Volume / Qty)**", unsafe_allow_html=True)
            with c2: jumlah = st.number_input("Jumlah", min_value=0.0, step=1.0, value=0.0, label_visibility="collapsed", key=f"jml_{idx}")
            
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>📏 **Satuan**", unsafe_allow_html=True)
            with c2:
                sub_sat1, sub_sat2 = st.columns([3, 1])
                with sub_sat1:
                    satuan_pilihan = st.selectbox("Pilih Satuan", ["-- Pilih Satuan --"] + st.session_state.master_satuan, label_visibility="collapsed", key=f"satuan_{idx}")
                with sub_sat2:
                    tambah_satuan_baru = st.text_input("Tambah Satuan", placeholder="Baru...", label_visibility="collapsed", key=f"tambah_satuan_{idx}")
                satuan_final = satuan_pilihan if satuan_pilihan != "-- Pilih Satuan --" else ""
                if tambah_satuan_baru.strip(): satuan_final = tambah_satuan_baru.strip()

            # Peruntukan (Alokasi Alat / Unit)
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>🎯 **Peruntukan (Alokasi Alat / Unit)**", unsafe_allow_html=True)
            with c2:
                sub_p1, sub_p2 = st.columns([3, 1])
                with sub_p1:
                    peruntukan_pilihan = st.selectbox("Pilih Alat / Unit", ["-- Pilih Alokasi Alat / Unit --"] + list_alat_opt, label_visibility="collapsed", key=f"peruntukan_sel_{idx}")
                with sub_p2:
                    peruntukan_manual = st.text_input("Atau Ketik Bebas", placeholder="Ketik manual...", label_visibility="collapsed", key=f"peruntukan_man_{idx}")
                peruntukan_final = peruntukan_pilihan if peruntukan_pilihan != "-- Pilih Alokasi Alat / Unit --" else ""
                if peruntukan_manual.strip(): peruntukan_final = peruntukan_manual.strip()

            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br><br>📝 **Uraian / Keterangan**", unsafe_allow_html=True)
            with c2: keterangan = st.text_area("Keterangan", placeholder="Uraian atau keterangan lengkap transaksi...", label_visibility="collapsed", key=f"ket_{idx}")
            
            # Nilai Transaksi (DPP)
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>💰 **Nilai Transaksi (DPP / Dasar)**", unsafe_allow_html=True)
            with c2:
                if suggested_dpp > 0:
                    st.info(f"💡 Nilai DPP tercatat pada invoice terpilih: **Rp {suggested_dpp:,.2f}**")
                    use_suggested = st.checkbox("Gunakan nilai DPP sesuai invoice tersebut", value=True, key=f"use_sugg_dpp_{idx}")
                    default_dpp_val = suggested_dpp if use_suggested else 0.0
                else:
                    default_dpp_val = 0.0
                dpp = st.number_input("DPP", min_value=0.0, step=10000.0, format="%.2f", value=default_dpp_val, label_visibility="collapsed", key=f"val_dpp_{idx}")
            
            c1, c2 = st.columns([1, 2])
            with c1: 
                st.markdown("<br>🏷️ **PPN (Pajak Pertambahan Nilai)**", unsafe_allow_html=True)
                pakai_ppn = st.checkbox("Gunakan PPN (11% Otomatis)", key=f"chk_ppn_{idx}")
            with c2:
                st.info("💡 Centang opsi pajak, pilih tarif PPh, lalu klik tombol hitung di bawah.")
            
            c1, c2 = st.columns([1, 2])
            with c1: 
                st.markdown("<br>📉 **PPH (Pajak Penghasilan)**", unsafe_allow_html=True)
                pakai_pph = st.checkbox("Gunakan PPh", key=f"chk_pph_{idx}")
                tarif_pilihan = st.selectbox("Tarif PPh", [0.01, 0.015, 0.0175, 0.02, 0.03, 0.04], format_func=lambda x: f"{x*100}%".replace(".0", ""), key=f"sel_tarif_{idx}", label_visibility="collapsed")
            with c2:
                if st.button("⚡ KLIK DISINI UNTUK HITUNG PAJAK OTOMATIS", use_container_width=True):
                    st.session_state[f'val_ppn_{idx}'] = round(dpp * 0.11, 2) if pakai_ppn else 0.0
                    st.session_state[f'val_pph_{idx}'] = round(dpp * tarif_pilihan, 2) if pakai_ppn else 0.0
                    st.success("Kalkulasi PPN & PPh berhasil diterapkan!")
                    st.rerun()

            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>🔹 **Nominal PPN**", unsafe_allow_html=True)
            with c2: ppn = st.number_input("PPN", min_value=0.0, step=1000.0, format="%.2f", label_visibility="collapsed", key=f"val_ppn_{idx}")
            
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>🔹 **Nominal PPh**", unsafe_allow_html=True)
            with c2: pph = st.number_input("PPh", min_value=0.0, step=1000.0, format="%.2f", label_visibility="collapsed", key=f"val_pph_{idx}")
            
            total_transaksi = (dpp + ppn) - pph
            
            c1, c2 = st.columns([1, 2])
            with c1: st.markdown("<br>💵 **Total Nilai Transaksi**", unsafe_allow_html=True)
            with c2: st.markdown(f"### **Rp {total_transaksi:,.2f}**")

            st.divider()
            col_b1, col_b2 = st.columns(2)
            with col_b1:
                if st.button("💾 Simpan Data Dokumen", use_container_width=True):
                    if dept_pilihan_input == "-- Pilih Departemen Tujuan --":
                        st.error("❌ GAGAL: Anda wajib memilih 'Departemen Tujuan' dokumen terlebih dahulu!")
                    elif dpp > 0 and no_bukti and bu_final and lawan_transaksi_final:
                        data_baru = {
                            "Nomor Bukti": no_bukti, "Tanggal": tgl, "Sumber Transaksi": sumber_transaksi,
                            "Lawan Transaksi": lawan_transaksi_final, "No Invoice": no_invoice_final,
                            "Jatuh Tempo": str(tgl_jatuh_tempo), "Business Unit": bu_final, "Departemen Tujuan": dept_pilihan_input,
                            "Jumlah": jumlah, "Satuan": satuan_final, "Peruntukan": peruntukan_final, "Keterangan": keterangan, 
                            "DPP": dpp, "PPN": ppn, "PPH": pph, "Total": total_transaksi, 
                            "Status Dokumen": f"Menunggu Approval Kabag {dept_pilihan_input}", "Status Jurnal": "Belum Dijurnal"
                        }
                        df_existing = st.session_state.data_operasional
                        if not df_existing.empty and no_bukti in df_existing['Nomor Bukti'].values:
                            df_existing.loc[df_existing['Nomor Bukti'] == no_bukti] = pd.DataFrame([data_baru]).values[0]
                            st.success(f"Nomor Bukti '{no_bukti}' diperbarui & dikirim ke Kabag {dept_pilihan_input}!")
                        else:
                            st.session_state.data_operasional = pd.concat([
                                df_existing, pd.DataFrame([data_baru])
                            ], ignore_index=True)
                            st.success(f"Dokumen berhasil disimpan dan diteruskan ke Kabag {dept_pilihan_input}!")
                    else:
                        st.error("Mohon lengkapi Nomor Bukti, Lawan Transaksi, Business Unit, dan pastikan nilai nominal > 0.")
                        
            with col_b2:
                if st.button("➕ Simpan & Mulai Form Baru", use_container_width=True):
                    if dept_pilihan_input == "-- Pilih Departemen Tujuan --":
                        st.error("❌ GAGAL: Anda wajib memilih 'Departemen Tujuan' dokumen terlebih dahulu!")
                    elif dpp > 0 and no_bukti and bu_final and lawan_transaksi_final:
                        data_baru = {
                            "Nomor Bukti": no_bukti, "Tanggal": tgl, "Sumber Transaksi": sumber_transaksi,
                            "Lawan Transaksi": lawan_transaksi_final, "No Invoice": no_invoice_final,
                            "Jatuh Tempo": str(tgl_jatuh_tempo), "Business Unit": bu_final, "Departemen Tujuan": dept_pilihan_input,
                            "Jumlah": jumlah, "Satuan": satuan_final, "Peruntukan": peruntukan_final, "Keterangan": keterangan, 
                            "DPP": dpp, "PPN": ppn, "PPH": pph, "Total": total_transaksi, 
                            "Status Dokumen": f"Menunggu Approval Kabag {dept_pilihan_input}", "Status Jurnal": "Belum Dijurnal"
                        }
                        df_existing = st.session_state.data_operasional
                        if not df_existing.empty and no_bukti in df_existing['Nomor Bukti'].values:
                            df_existing.loc[df_existing['Nomor Bukti'] == no_bukti] = pd.DataFrame([data_baru]).values[0]
                        else:
                            st.session_state.data_operasional = pd.concat([
                                df_existing, pd.DataFrame([data_baru])
                            ], ignore_index=True)
                        st.session_state.form_index += 1
                        st.success(f"Tersimpan & dikirim ke Kabag {dept_pilihan_input}! Form direset.")
                        st.rerun()
                    else:
                        st.error("Mohon lengkapi Nomor Bukti, Lawan Transaksi, Business Unit, dan pastikan nilai nominal > 0.")

    else:
        # --- MENU DATA TERSIMPAN & PUSAT KENDALI APPROVAL ---
        st.markdown("### 📂 Pusat Kendali Dokumen & Persetujuan Berjenjang (Workflow)")
        
        if not st.session_state.data_operasional.empty:
            df_pusat = st.session_state.data_operasional.copy()
            
            role = st.session_state.get('user_role', 'Staf')
            dept_kini = st.session_state.get('user_dept', 'Operasional')

            st.dataframe(df_pusat, use_container_width=True)

            st.markdown("---")
            st.markdown("#### 🔄 Menu Koreksi, Revisi, atau Approval Berjenjang")
            
            list_nobukti_doc = df_pusat['Nomor Bukti'].tolist()
            pilih_nobukti_edit = st.selectbox("Pilih Nomor Bukti untuk Diproses", ["-- Pilih Nomor Bukti --"] + list_nobukti_doc, key="sel_workflow_nobukti")
            
            if pilih_nobukti_edit and pilih_nobukti_edit != "-- Pilih Nomor Bukti --":
                row_data = df_pusat[df_pusat['Nomor Bukti'] == pilih_nobukti_edit].iloc[0]
                status_kini = row_data.get('Status Dokumen', 'Menunggu Approval Kabag')
                
                st.warning(f"📌 Status Dokumen Saat Ini: **{status_kini}**")

                col_app1, col_app2, col_app3 = st.columns(3)
                with col_app1:
                    if role == "Kabag" and st.button(f"✅ Approve Kabag ({dept_kini})"):
                        st.session_state.data_operasional.loc[st.session_state.data_operasional['Nomor Bukti'] == pilih_nobukti_edit, 'Status Dokumen'] = f"Disetujui Kabag {dept_kini} ➡️ Menunggu Jurnal"
                        st.success(f"Dokumen disetujui oleh Kabag {dept_kini}!")
                        st.rerun()
                with col_app2:
                    if role == "Keuangan" and st.button("📝 Beri Rekening & Jurnal"):
                        st.session_state.data_operasional.loc[st.session_state.data_operasional['Nomor Bukti'] == pilih_nobukti_edit, ['Status Jurnal', 'Status Dokumen']] = ["Sudah Dijurnal", "Menunggu Approval Manajer"]
                        st.success("Dokumen berhasil dijurnal oleh Keuangan dan diteruskan ke Manajer!")
                        st.rerun()
                with col_app3:
                    if role == "Manajer" and st.button("⭐ Approval Final Manajer"):
                        st.session_state.data_operasional.loc[st.session_state.data_operasional['Nomor Bukti'] == pilih_nobukti_edit, 'Status Dokumen'] = "Approved Final (Sah)"
                        st.success("Dokumen disetujui final oleh Manajer!")
                        st.rerun()

                with st.form("form_koreksi_dokumen"):
                    st.markdown("#### Edit Data Dokumen")
                    ed_nobukti = st.text_input("Nomor Bukti", value=row_data['Nomor Bukti'])
                    ed_lawan = st.text_input("Lawan Transaksi", value=row_data.get('Lawan Transaksi', ''))
                    ed_invoice = st.text_input("Nomor Invoice", value=row_data.get('No Invoice', '-'))
                    ed_dpp = st.number_input("DPP / Nilai", value=float(row_data['DPP']), step=10000.0, format="%.2f")
                    ed_ppn = st.number_input("PPN", value=float(row_data['PPN']), step=1000.0, format="%.2f")
                    ed_pph = st.number_input("PPh", value=float(row_data['PPH']), step=1000.0, format="%.2f")
                    ed_ket = st.text_area("Uraian / Keterangan", value=row_data['Keterangan'])
                    
                    ed_total = (ed_dpp + ed_ppn) - ed_pph
                    st.markdown(f"**Total Baru: Rp {ed_total:,.2f}**")
                    
                    col_e1, col_e2 = st.columns(2)
                    with col_e1: btn_update = st.form_submit_button("🔄 Update / Simpan Perubahan")
                    with col_e2: btn_hapus = st.form_submit_button("🗑️ Hapus Dokumen Ini")
                    
                    if btn_update:
                        st.session_state.data_operasional.loc[st.session_state.data_operasional['Nomor Bukti'] == pilih_nobukti_edit, ['Nomor Bukti', 'Lawan Transaksi', 'No Invoice', 'DPP', 'PPN', 'PPH', 'Total', 'Keterangan']] = [ed_nobukti, ed_lawan, ed_invoice, ed_dpp, ed_ppn, ed_pph, ed_total, ed_ket]
                        st.success(f"Dokumen {ed_nobukti} berhasil diperbarui!")
                        st.rerun()
                        
                    if btn_hapus:
                        st.session_state.data_operasional = st.session_state.data_operasional[st.session_state.data_operasional['Nomor Bukti'] != pilih_nobukti_edit]
                        st.success(f"Dokumen dengan Nomor Bukti {pilih_nobukti_edit} berhasil dihapus dari sistem!")
                        st.rerun()
        else:
            st.info("Belum ada data dokumen operasional yang tersimpan di dalam sistem.")